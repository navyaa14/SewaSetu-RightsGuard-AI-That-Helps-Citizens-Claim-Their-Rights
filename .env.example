# Public DNS name of the VM (an A record pointing at it). Free option: <ip>.sslip.io
DOMAIN=sewasetu.example.in
# openssl rand -hex 32  (both; the database is internal-only, but no shared default passwords)
SECRET_KEY=
DB_PASSWORD=
# district (all-blocks) officer login, also the login given to the assessors
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=District Social Welfare Officer
# block officers: username|Full Name|Block|password; separated by ;
OFFICER_ACCOUNTS=rina.sonari|Rina Gogoi|Sonari|change-me;abdul.khelua|Abdul Hussain|Khelua|change-me
# blocks served through AI assistants (Director: pilot in a subset of blocks)
AGENT_BLOCKS=Sonari,Rajapara,Dhemaji Pathar,Borgaon,Namti,Khelua
